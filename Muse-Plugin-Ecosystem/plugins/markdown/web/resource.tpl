<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content"><title>OpenMuse</title><script>window.addEventListener("error",function(e){window.OpenMuseResource?.postMessage(JSON.stringify({method:"error",data:{message:e.message+" @ "+e.filename+":"+e.lineno}}));});window.addEventListener("unhandledrejection",function(e){window.OpenMuseResource?.postMessage(JSON.stringify({method:"error",data:{message:String(e.reason)}}));});</script><style>html,body{height:100%;margin:0;overflow:hidden}#resource-editor{height:100%;width:100%;min-width:0}#resource-editor .protyle-content{min-width:0}body{background:var(--b3-theme-background)}.openmuse-empty-title .protyle-title__input,.openmuse-empty-title .protyle-title__icon{display:none}</style></head><body aria-busy="true"><main id="resource-editor"></main><div id="commonMenu" class="b3-menu fn__none"><div class="b3-menu__title fn__none"><svg class="b3-menu__icon"><use xlink:href="#iconLeft"></use></svg><span class="b3-menu__label"></span></div><div class="b3-menu__items"></div></div><div id="message" class="b3-snackbars"></div><div id="tooltip" class="tooltip fn__none"></div></body></html>
