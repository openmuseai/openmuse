<!DOCTYPE html><html data-openmuse-resource-platform="mobile"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content"><title>OpenMuse</title><script>window.addEventListener("error",function(e){window.OpenMuseResource?.postMessage(JSON.stringify({method:"error",data:{message:e.message+" @ "+e.filename+":"+e.lineno}}));});window.addEventListener("unhandledrejection",function(e){window.OpenMuseResource?.postMessage(JSON.stringify({method:"error",data:{message:String(e.reason)}}));});</script><style>html,body{height:100%;margin:0;overflow:hidden}#editor{min-height:0;min-width:0;width:100%;flex:1}#editor .protyle-content{min-width:0}body{background:var(--b3-theme-background)}.openmuse-empty-title .protyle-title__input,.openmuse-empty-title .protyle-title__icon{display:none}</style></head><body class="fn__flex-column" aria-busy="true">
<div id="mobileTopBar" class="toolbar toolbar--border mobile-topbar">
<input class="toolbar__title fn__hidden" id="toolbarName" autocomplete="off" enterkeyhint="next" data-prevent-swipe>
<span class="toolbar__title toolbar__title--readonly fn__hidden fn__none" id="toolbarNameReadonly" data-prevent-swipe></span>
</div>
<div id="editor" class="fn__flex-1"></div>
<div id="menu" class="b3-menu b3-menu--fullscreen"></div>
<div id="model" class="side-panel side-panel--all fn__flex-column"><div class="toolbar toolbar--border"><svg class="toolbar__icon"><use xlink:href="#iconMenu"></use></svg><span class="toolbar__text"></span><svg id="modelClose" class="toolbar__icon"><use xlink:href="#iconCloseRound"></use></svg></div><div id="modelMain" class="fn__flex-1"></div></div>
<div id="commonMenuScrim" class="b3-menu__scrim fn__none" data-prevent-swipe aria-hidden="true"></div>
<div id="commonMenu" class="b3-menu fn__none"><div class="b3-menu__title fn__none"><svg class="b3-menu__icon"><use xlink:href="#iconLeft"></use></svg><span class="b3-menu__label"></span></div><div class="b3-menu__items"></div></div><div id="message" class="b3-snackbars"></div><div id="tooltip" class="tooltip fn__none"></div><div id="keyboardToolbar" class="keyboard fn__none"></div><div class="side-mask fn__none"></div></body></html>
