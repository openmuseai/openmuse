  "cards": [
    {
      "dot": "cyan",
      "title": "三区工作台",
      "items": [
        "左栏 Workspace 资源树，中区编辑器 PluginSlot，右栏 Right PanelSlot 由 DSH 占据",
        "桌面、Web、手机共用同一套布局模型与 Host 侧区域定义"
      ]
    },
    {
      "dot": "emerald",
      "title": "插件生命周期",
      "items": [
        "Manifest 声明 runtime、权限与 contributions，按 activation events 激活和停用",
        "Host 不依赖 Helix / DSH / Viewer 实现包；装配层 createOpenMuseBuiltInPlugins 决定首发集合"
      ]
    },
    {
      "dot": "rose",
      "title": "能力与权限边界",
      "items": [
        "插件之间不直接调用；跨插件能力经 Host 中介并带超时与取消",
        "DSH 只能调用窄命令（workspace.snapshot / openResource），CLI 只走 loopback Broker + Bearer 令牌"
      ]
    }
  ]
