    "compactBelow": 900,
    "minDocumentWidth": 400
  },
  "menuPresentation": {
    "ribbon": {
      "minWidth": 148,
      "padding": 4,
      "radius": 10,
      "offsetY": 6,
      "itemHeight": 28,
      "itemHorizontalPadding": 10,
      "fontSize": 12.5,
      "elevation": 4,
      "shadowOpacity": 0.14
    },
    "thumbnail": {
      "minWidth": 170,
      "padding": 5,
      "radius": 6,
      "offsetY": 0,
      "itemHeight": 32,
      "itemHorizontalPadding": 12,
      "fontSize": 13,
      "elevation": 5,
      "shadowOpacity": 0.18
    },
    "palette": {
      "minWidth": 0,
      "padding": 8,
      "radius": 10,
      "offsetY": 6,
      "itemHeight": 0,
      "itemHorizontalPadding": 0,
      "fontSize": 12.5,
      "elevation": 4,
      "shadowOpacity": 0.14
    }
  },
  "sidebar": {
    "minWidth": 120,
    "maxWidth": 320,
    "maxViewportFraction": 0.4,
    "rasterInset": 24,
    "resizerWidth": 6,
    "resizerOverlap": 3,
    "preferenceKey": "openmuse.pdf.sidebar.width"
  },
  "pageViewport": {
    "horizontalPadding": 24,
    "verticalPadding": 16,
    "pageGap": 16,
