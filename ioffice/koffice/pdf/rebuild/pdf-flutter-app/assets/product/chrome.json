    "spreadButton": {"label": "单页", "icon": "IconSinglePage"}
  },
  "aiDock": {
    "defaultWidth": 360,
    "minWidth": 280,
    "maxWidth": 720,
    "maxViewportFraction": 0.6,
    "railWidth": 34,
    "resizerWidth": 6,
    "transitionMs": 180,
    "widthPreferenceKey": "openmuse.pdf.ai.width",
    "openPreferenceKey": "openmuse.pdf.ai.open",
    "initiallyOpen": true,
    "title": "Muse AI",
    "openLabel": "打开 AI 助手",
    "collapseLabel": "收起 AI 助手",
    "emptyTitle": "问问这份 PDF",
