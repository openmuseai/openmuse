      "hint": "页码或范围，如 1-3,5（共 {total} 页）",
      "desktopDestination": "generatedDirectory",
      "desktopOpenResult": "newDocumentTab",
      "mobileDestination": "savePicker",
      "singleNamePattern": "{base}-p{first}.pdf",
      "rangeNamePattern": "{base}-p{first}-{last}.pdf",
      "cancel": "取消",
      "confirm": "确定"
    },
    "splitPdf": {
      "command": "pdf.page.split",
      "title": "拆分 PDF",
      "hint": "每 N 页拆分为一个文件（共 {total} 页）",
      "destinationMode": "directory",
      "fileNamePattern": "{base}-{index}.pdf",
      "cancel": "取消",
      "confirm": "确定"
