+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPFormObj_InsertObjectAtIndex(FPDF_PAGEOBJECT form_object,
+                               FPDF_PAGEOBJECT page_object,
+                               unsigned long index) {
+  CPDF_PageObject* cform_page_object =
+      CPDFPageObjectFromFPDFPageObject(form_object);
+  CPDF_FormObject* form_obj =
+      cform_page_object ? cform_page_object->AsForm() : nullptr;
+  CPDF_PageObject* child = CPDFPageObjectFromFPDFPageObject(page_object);
+  if (!form_obj || !child || index > form_obj->form()->GetPageObjectCount()) {
+    return false;
+  }
+  // Match FPDFPage_InsertObjectAtIndex ownership: on success the Form owns
+  // the raw page object supplied by the caller.
+  if (!form_obj->form()->InsertPageObjectAtIndex(
+          index, std::unique_ptr<CPDF_PageObject>(child))) {
+    return false;
+  }
+  CPDF_PageContentGenerator(form_obj->form())
+      .GenerateFormContent(form_obj->form());
+  cform_page_object->SetDirty(true);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPFormObj_FlushContents(FPDF_PAGEOBJECT form_object) {
+  CPDF_PageObject* cform_page_object =
+      CPDFPageObjectFromFPDFPageObject(form_object);
+  CPDF_FormObject* form_obj =
+      cform_page_object ? cform_page_object->AsForm() : nullptr;
+  if (!form_obj) {
+    return false;
+  }
+  CPDF_PageContentGenerator(form_obj->form())
+      .GenerateFormContent(form_obj->form());
+  cform_page_object->SetDirty(true);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPFormObj_MarkChildDirty(FPDF_PAGEOBJECT form_object,
+                          FPDF_PAGEOBJECT page_object) {
+  CPDF_PageObject* cform_page_object =
+      CPDFPageObjectFromFPDFPageObject(form_object);
+  CPDF_FormObject* form_obj =
+      cform_page_object ? cform_page_object->AsForm() : nullptr;
+  CPDF_PageObject* child = CPDFPageObjectFromFPDFPageObject(page_object);
+  if (!form_obj || !child) {
+    return false;
+  }
+
+  CPDF_Form* form = form_obj->form();
+  size_t index = 0;
+  while (index < form->GetPageObjectCount() &&
+         form->GetPageObjectByIndex(index) != child) {
+    ++index;
+  }
+  if (index == form->GetPageObjectCount()) {
+    return false;
+  }
+
+  std::unique_ptr<CPDF_PageObject> owned = form->RemovePageObject(child);
+  if (!owned || !form->InsertPageObjectAtIndex(index, std::move(owned))) {
+    return false;
+  }
+  // Flush the child mutation into this private Form stream immediately. The
+  // page generator only visits a Form holder while rewriting its parent; doing
+  // this here also makes nested Forms deterministic from inner to outer.
+  CPDF_PageContentGenerator(form).GenerateFormContent(form);
+  cform_page_object->SetDirty(true);
+  return true;
+}
+
+namespace {
+
+bool KSPDetachForms(CPDF_PageObjectHolder* holder) {
+  for (size_t index = 0; index < holder->GetPageObjectCount(); ++index) {
+    CPDF_PageObject* object = holder->GetPageObjectByIndex(index);
+    CPDF_FormObject* form_object = object ? object->AsForm() : nullptr;
+    if (!form_object) {
+      continue;
+    }
+    CPDF_Form* source = form_object->form();
+    RetainPtr<CPDF_Stream> stream = ToStream(source->GetStream()->Clone());
+    if (!stream) {
+      return false;
+    }
+    source->GetDocument()->AddIndirectObject(stream);
+    auto detached = std::make_unique<CPDF_Form>(
+        source->GetDocument(), source->GetMutablePageResources(), stream,
+        source->GetMutableResources().Get());
+    detached->ParseContent();
+    if (!KSPDetachForms(detached.get())) {
+      return false;
+    }
+    form_object->ReplaceFormForEditing(std::move(detached));
+    // SetDirty() alone is not sufficient for all parsed holders. Reinsert the
+    // same object at the same index so the owning content stream is explicitly
+    // scheduled for regeneration without changing z-order or ownership.
+    std::unique_ptr<CPDF_PageObject> owned = holder->RemovePageObject(object);
+    if (!owned || !holder->InsertPageObjectAtIndex(index, std::move(owned))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPPage_SeparateSharedForms(FPDF_PAGE page) {
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  return pdf_page && KSPDetachForms(pdf_page);
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPTextObj_SetFont(FPDF_PAGEOBJECT text_object, FPDF_FONT font) {
+  CPDF_PageObject* page_object =
+      CPDFPageObjectFromFPDFPageObject(text_object);
+  CPDF_TextObject* text = page_object ? page_object->AsText() : nullptr;
+  CPDF_Font* pdf_font = CPDFFontFromFPDFFont(font);
+  if (!text || !pdf_font) {
+    return false;
+  }
+  text->mutable_text_state().SetFont(pdfium::WrapRetain(pdf_font));
+  // Recompute advances and bounds with the replacement font. Keeping the old
+  // font's cached geometry makes subsequent caret and paragraph alignment use
+  // stale widths even though the generated content already references the new
+  // font.
+  text->SetTextMatrix(text->GetTextMatrix());
+  text->SetDirty(true);
+  return true;
+}
diff --git a/fpdfsdk/fpdf_edittext.cpp b/fpdfsdk/fpdf_edittext.cpp
index 727d302..5c1e431 100644
--- a/fpdfsdk/fpdf_edittext.cpp
+++ b/fpdfsdk/fpdf_edittext.cpp
@@ -834,0 +835,11 @@ FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDFFont_GetGlyphWidth(FPDF_FONT font,
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPFont_CanEncodeUnicode(FPDF_FONT font, uint32_t unicode) {
+  CPDF_Font* pdf_font = CPDFFontFromFPDFFont(font);
+  if (!pdf_font || unicode == 0 || unicode > 0x10ffff) {
+    return false;
+  }
+  const uint32_t charcode =
+      pdf_font->CharCodeFromUnicode(static_cast<wchar_t>(unicode));
+  return charcode != 0 && charcode != static_cast<uint32_t>(-1);
+}
+
