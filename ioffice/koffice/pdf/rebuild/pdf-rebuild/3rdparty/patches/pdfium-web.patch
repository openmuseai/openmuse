diff --git a/BUILD.gn b/BUILD.gn
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -19,6 +19,11 @@
   if (pdf_is_standalone) {
     deps += [ ":pdfium_all" ]
   }
+}
+
+# Build the fixed product PDFium with the Emscripten secondary toolchain.
+group("ksp_web_pdfium") {
+  deps = [ ":pdfium(//build/toolchain/wasm:wasm)" ]
 }
 
 group("freetype_common") {
@@ -237,7 +242,11 @@
   ]
 }
 
-shared_library("pdfium") {
+_pdfium_library_type = "shared_library"
