+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPFont_CanEncodeUnicode(FPDF_FONT font, uint32_t unicode) {
+  CPDF_Font* pdf_font = CPDFFontFromFPDFFont(font);
+  if (!pdf_font || unicode == 0 || unicode > 0x10ffff) {
+    return false;
