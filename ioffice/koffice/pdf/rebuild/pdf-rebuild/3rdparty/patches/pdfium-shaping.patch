+FPDF_EXPORT int FPDF_CALLCONV
+KSPBidi_GetVisualRuns(FPDF_WIDESTRING text,
+                      int length,
+                      int paragraph_direction,
+                      KSP_BIDI_RUN* runs,
+                      int capacity) {
+  if (!text || length < 0 || capacity < 0 || paragraph_direction < -1 ||
+      paragraph_direction > 1) {
+    return -1;
+  }
+  if (length == 0) {
+    return 0;
+  }
+  CFX_BidiResolver::ParagraphDirection direction =
+      CFX_BidiResolver::ParagraphDirection::kAuto;
+  if (paragraph_direction == 0) {
+    direction = CFX_BidiResolver::ParagraphDirection::kLeftToRight;
+  } else if (paragraph_direction == 1) {
+    direction = CFX_BidiResolver::ParagraphDirection::kRightToLeft;
+  }
+  std::u16string value(reinterpret_cast<const char16_t*>(text),
+                       static_cast<size_t>(length));
+  std::unique_ptr<CFX_BidiResolver> resolver =
+      CFX_BidiResolver::Create(std::move(value), direction);
+  if (!resolver) {
+    return -1;
+  }
+  std::vector<CFX_BidiResolver::ResolvedRun> resolved =
+      resolver->GetVisualRunsForLine(0, length);
+  const int count = pdfium::checked_cast<int>(resolved.size());
+  if (!runs || capacity < count) {
+    return count;
+  }
+  for (int index = 0; index < count; ++index) {
+    runs[index].start = resolved[index].start;
+    runs[index].length = resolved[index].length;
+    runs[index].is_rtl = resolved[index].is_rtl;
+  }
+  return count;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+KSPFont_ShapeText(FPDF_FONT font,
+                  FPDF_WIDESTRING text,
+                  int length,
+                  int direction,
+                  KSP_SHAPED_GLYPH* glyphs,
+                  int capacity) {
+  CPDF_Font* pdf_font = CPDFFontFromFPDFFont(font);
+  if (!pdf_font || !text || length < 0 || capacity < 0 || direction < 0 ||
+      direction > 1) {
+    return -1;
+  }
+  if (length == 0) {
+    return 0;
+  }
+  const auto font_data = pdf_font->GetFont()->GetFontSpan();
+  if (font_data.empty()) {
+    return -1;
+  }
+  hb_blob_t* blob = hb_blob_create_or_fail(
+      reinterpret_cast<const char*>(font_data.data()),
+      pdfium::checked_cast<unsigned int>(font_data.size()),
+      HB_MEMORY_MODE_READONLY, nullptr, nullptr);
+  if (!blob) {
+    return -1;
+  }
+  hb_face_t* face = hb_face_create(blob, 0);
+  hb_font_t* hb_font = hb_font_create(face);
+  hb_buffer_t* buffer = hb_buffer_create();
+  const unsigned int upem = hb_face_get_upem(face);
+  if (!face || !hb_font || !buffer || upem == 0) {
+    if (buffer) hb_buffer_destroy(buffer);
+    if (hb_font) hb_font_destroy(hb_font);
+    if (face) hb_face_destroy(face);
+    hb_blob_destroy(blob);
+    return -1;
+  }
+  hb_ot_font_set_funcs(hb_font);
+  hb_font_set_scale(hb_font, static_cast<int>(upem), static_cast<int>(upem));
+  // Keep combining characters addressable where the shaper can do so while
+  // still allowing GSUB ligatures to merge their logical input cluster.
+  hb_buffer_set_cluster_level(buffer, HB_BUFFER_CLUSTER_LEVEL_MONOTONE_CHARACTERS);
+  hb_buffer_add_utf16(buffer, reinterpret_cast<const uint16_t*>(text), length,
+                      0, length);
+  hb_buffer_guess_segment_properties(buffer);
+  hb_buffer_set_direction(buffer, direction ? HB_DIRECTION_RTL : HB_DIRECTION_LTR);
+  hb_shape(hb_font, buffer, nullptr, 0);
+  unsigned int glyph_count = 0;
+  const hb_glyph_info_t* info = hb_buffer_get_glyph_infos(buffer, &glyph_count);
+  const hb_glyph_position_t* positions =
+      hb_buffer_get_glyph_positions(buffer, &glyph_count);
+  const int count = pdfium::checked_cast<int>(glyph_count);
+  if (glyphs && capacity >= count && info && positions) {
+    const float scale = 1.0f / static_cast<float>(upem);
+    for (int index = 0; index < count; ++index) {
+      glyphs[index].glyph_id = info[index].codepoint;
+      glyphs[index].cluster = info[index].cluster;
+      glyphs[index].x_advance = positions[index].x_advance * scale;
+      glyphs[index].y_advance = positions[index].y_advance * scale;
+      glyphs[index].x_offset = positions[index].x_offset * scale;
+      glyphs[index].y_offset = positions[index].y_offset * scale;
+    }
+  }
+  hb_buffer_destroy(buffer);
+  hb_font_destroy(hb_font);
+  hb_face_destroy(face);
+  hb_blob_destroy(blob);
+  return count;
+}
