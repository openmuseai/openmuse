+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPTextObj_SetGlyphPositions(FPDF_PAGEOBJECT text_object,
+                             const float* xy_positions,
+                             size_t glyph_count) {
+  CPDF_PageObject* page_object =
+      CPDFPageObjectFromFPDFPageObject(text_object);
+  CPDF_TextObject* text = page_object ? page_object->AsText() : nullptr;
+  if (!text || !xy_positions || glyph_count != text->CharCount()) {
+    return false;
+  }
+  std::vector<CFX_PointF> positions;
+  positions.reserve(glyph_count);
+  for (size_t index = 0; index < glyph_count; ++index) {
+    positions.emplace_back(xy_positions[index * 2],
+                           xy_positions[index * 2 + 1]);
+  }
+  if (!text->SetIndividualPositions(positions)) {
+    return false;
+  }
+  text->SetDirty(true);
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPTextObj_SetActualText(FPDF_PAGEOBJECT text_object,
+                         FPDF_WIDESTRING logical_text,
+                         size_t length,
+                         uint32_t run_id) {
+  CPDF_PageObject* page_object =
+      CPDFPageObjectFromFPDFPageObject(text_object);
+  CPDF_TextObject* text = page_object ? page_object->AsText() : nullptr;
+  if (!text || (!logical_text && length != 0) || (length != 0 && run_id == 0)) {
+    return false;
+  }
+  CPDF_ContentMarks* marks = text->GetContentMarks();
+  for (size_t index = marks->CountItems(); index > 0; --index) {
+    CPDF_ContentMarkItem* item = marks->GetItem(index - 1);
+    RetainPtr<const CPDF_Dictionary> params = item->GetParam();
+    if (params && params->GetIntegerFor("KSPRunId") > 0) {
+      marks->RemoveMark(item);
+    }
+  }
+  WideString logical;
+  if (length != 0) {
+    auto utf16 = UNSAFE_BUFFERS(pdfium::span(logical_text, length));
+    logical = WideString::FromUTF16LE(pdfium::as_byte_span(utf16));
+  }
+  text->SetActualText(PDF_EncodeText(logical.AsStringView()), run_id);
+  text->SetDirty(true);
+  return true;
+}
