+bool KSPDetachForms(CPDF_PageObjectHolder* holder) {
+  for (size_t index = 0; index < holder->GetPageObjectCount(); ++index) {
+    CPDF_PageObject* object = holder->GetPageObjectByIndex(index);
+    CPDF_FormObject* form_object = object ? object->AsForm() : nullptr;
+    if (!form_object) {
+      continue;
+    }
+    CPDF_Form* source = form_object->form();
+    RetainPtr<CPDF_Stream> stream = ToStream(source->GetStream()->Clone());
+    if (!stream) {
+      return false;
+    }
+    source->GetDocument()->AddIndirectObject(stream);
+    auto detached = std::make_unique<CPDF_Form>(
+        source->GetDocument(), source->GetMutablePageResources(), stream,
+        source->GetMutableResources().Get());
+    detached->ParseContent();
+    if (!KSPDetachForms(detached.get())) {
+      return false;
+    }
+    form_object->ReplaceFormForEditing(std::move(detached));
+    // SetDirty() alone is not sufficient for all parsed holders. Reinsert the
+    // same object at the same index so the owning content stream is explicitly
+    // scheduled for regeneration without changing z-order or ownership.
+    std::unique_ptr<CPDF_PageObject> owned = holder->RemovePageObject(object);
+    if (!owned || !holder->InsertPageObjectAtIndex(index, std::move(owned))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+KSPPage_SeparateSharedForms(FPDF_PAGE page) {
+  CPDF_Page* pdf_page = CPDFPageFromFPDFPage(page);
+  return pdf_page && KSPDetachForms(pdf_page);
+}
