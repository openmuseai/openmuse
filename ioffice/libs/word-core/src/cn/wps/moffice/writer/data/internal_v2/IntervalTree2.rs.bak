// Java: public class OverLapInterval
impl OverLapInterval {
    pub fn new() -> Self {
        OverLapInterval {
            mNodeList: Vec::new(),
            mPosList: WIntArrayList::new(),
            mSize: 0,
            mFilterReadOnly: None,
        }
    }

    // Java: void setFiltercallback(IFilterCallback filtercallback)
    pub fn setFiltercallback(&mut self, filtercallback: Box<dyn IFilterCallback>) {
         // Java: this.mFilterReadOnly = filtercallback;
         self.mFilterReadOnly = Some(filtercallback);
    }

    // Java: void recycle()
    pub fn recycle(&mut self) {
         // Java: this.mSize = 0;
         self.mSize = 0;
         // Java: this.mNodeList.clear();
         self.mNodeList.clear();
         // Java: this.mPosList.resetQuick();
         self.mPosList.resetQuick();
         // Java: this.mFilterReadOnly = null;
         self.mFilterReadOnly = None;
         // Java: IntervalTree2.sOverlapPool.returnObject(this);
    }

    // Java: int size()
    pub fn size(&self) -> i32 {
         // Java: return this.mSize;
         self.mSize
    }

    // Java: int getPos(int index)
    pub fn getPos(&self, index: i32) -> i32 {
         // Java: return index >= 0 && index < this.mSize ? this.mPosList.get(this.mSize - index - 1) : -1;
         if index >= 0 && index < self.mSize {
             self.mPosList.get(self.mSize - index - 1)
         } else {
             -1
         }
    }

    // Java: IntervalNode2 getNode(int index)
    pub fn getNode_at(&self, index: i32) -> Option<&dyn Any> {
         // Java: return index >= 0 && index < this.mSize ? (IntervalNode2)this.mNodeList.get(this.mSize - index - 1) : null;
         if index >= 0 && index < self.mSize {
             let idx = (self.mSize - index - 1) as usize;
             self.mNodeList.get(idx).map(|b| b.as_ref())
         } else {
             None
         }
    }

    // Java: void onMeetOne(IntervalNode2 node, int pos)
    pub fn onMeetOne(&mut self, node: Box<dyn Any>, pos: i32) {
         // Java: if (this.mFilterReadOnly == null || this.mFilterReadOnly.onFilter(node))
         let should_add = match &self.mFilterReadOnly {
             None => true,
             Some(filter) => filter.onFilter(node.as_ref()),
         };
         if should_add
         {
            // Java: this.mPosList.add(pos);
            self.mPosList.add(pos);
            // Java: this.mNodeList.add(node);
            self.mNodeList.push(node);
            // Java: ++this.mSize;
            self.mSize += 1;
         }
    }

}

impl IEnumInterval for OverLapInterval {
    fn onMeetOne(&self, _var1: &dyn Any, _var2: i32) {
    }
}

impl IOverlapResult for OverLapInterval {
    fn recycle(&mut self) {
        self.mSize = 0;
        self.mNodeList.clear();
        self.mPosList.resetQuick();
        self.mFilterReadOnly = None;
    }

    fn size(&self) -> i32 {
        self.mSize
    }

    fn getPos(&self, index: i32) -> i32 {
        OverLapInterval::getPos(self, index)
    }

    fn getNode(&self, index: i32) -> Option<&dyn Any> {
        self.getNode_at(index)
    }
}
