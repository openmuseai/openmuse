        if (self.startSound.is_some()
         {
            // Java: this.startSound = null;
            self.startSound = None;
         }
    }

    // Java: void writeStartSound(Media.EmbeddedWAVAudioFile value)
    pub fn writeStartSound(&mut self, value: &mut EmbeddedWAVAudioFile) {
         // Java: if (value != null)
        if (value.is_some()
         {
            // Java: KoBin bin = value.lastBin(this.zone);
            let bin = value.lastBin(self.zone);
            // Java: if (KoBin.Null.notEmpty(bin))
            if (KoBin.Null.notEmpty(bin)
            {
               // Java: this.map.put(2, bin);
               self.map.put(2, bin);
               // Java: if (this.startSound != null)
                if (self.startSound.is_some()
               {
                  // Java: this.startSound = null;
                  self.startSound = None;
               }
            }
         }
    }

    // Java: void forceWriteStartSound(Media.EmbeddedWAVAudioFile value)
    pub fn forceWriteStartSound(&mut self, value: &mut EmbeddedWAVAudioFile) {
         // Java: if (value != null)
        if (value.is_some()
         {
            // Java: this.map.put(2, value.lastBin(this.zone));
            self.map.put(2, value.lastBin(self.zone));
            // Java: if (this.startSound != null)
            if (self.startSound.is_some()
            {
               // Java: this.startSound = null;
               self.startSound = None;
            }
         }
    }

    // Java: boolean isLoop()
    pub fn isLoop(&mut self) -> bool {
         // Java: if (!this.map.has(3))
        if (!self.map.has(3)
         {
            // Java: return this.parent == null ? false : this.parent.isLoop();
            return if self.parent.is_none() { false } else { self.parent.as_ref().unwrap().isLoop() };
         }
         // Java: else
        else
         {
            // Java: KoBin bin = this.map.byKey(3);
            let bin = self.map.byKey(3);
            // Java: return KoBin.Decode.toBool(bin);
            return Decode::toBool(bin.as_ref());
         }
    }

    // Java: boolean hasLoop()
    pub fn hasLoop(&mut self) -> bool {
         // Java: return this.map.has(3) || this.parent != null && this.parent.hasLoop();
         return self.map.has(3);
    }

    // Java: void deleteLoop()
    pub fn deleteLoop(&mut self) {
         // Java: this.map.put(3, (KoBin)null);
         self.map.clear_key(3);
    }

    // Java: void putLoop(boolean value)
    pub fn putLoop(&mut self, value: bool) {
         // Java: this.map.put(3, KoBin.Encode.from(value, this.zone));
         self.map.put(3, Encode::from_int(value, self.zone));
    }

}


impl KoAr for Transition {
    fn loadBin(&mut self, bin: &dyn KoBinTrait, zone: &KoZone) { Transition::loadBin(self, bin, zone); }
    fn saveBin(&self, zone: &KoZone) -> Box<dyn KoBinTrait> { todo!() }
    fn dirty(&self) -> bool { Transition::dirty(self) }
    fn lastBin(&self, zone: &KoZone) -> Box<dyn KoBinTrait> { Transition::lastBin(self, zone) }
}


impl KoClosable for Transition {
    fn close(&mut self) { Transition::close(self); }
}
