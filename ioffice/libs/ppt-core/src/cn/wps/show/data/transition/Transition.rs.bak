    // Java: void follow(SoundAction parent)
    pub fn follow(&mut self, parent: &mut SoundAction) {
         // Java: if (parent != null)
        if (parent.is_some()
         {
            // Java: parent.discard();
            parent.discard();
            // Java: this.discard();
            self.discard();
            // Java: this.parent = parent;
            self.parent = parent;
         }
    }

    // Java: void unFollow()
    pub fn unFollow(&mut self) {
         // Java: if (this.parent != null)
        if (self.parent.is_some()
         {
            // Java: this.discard();
            self.discard();
            // Java: this.parent.discard();
