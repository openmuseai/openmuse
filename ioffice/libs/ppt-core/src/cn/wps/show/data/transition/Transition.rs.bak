    // Java: int mode()
    pub fn mode(&mut self) -> i32 {
         // Java: if (!this.map.has(1))
        if (!self.map.has(1)
         {
            // Java: return this.parent == null ? 0 : this.parent.mode();
            return if self.parent.is_none() { 0 } else { self.parent.as_ref().unwrap().mode() };
         }
         // Java: else
        else
         {
            // Java: KoBin bin = this.map.byKey(1);
            let bin = self.map.byKey(1);
            // Java: return KoBin.Decode.toInt(bin);
            return Decode::toInt(bin.as_ref());
         }
    }

    // Java: boolean hasMode()
    pub fn hasMode(&mut self) -> bool {
         // Java: return this.map.has(1) || this.parent != null && this.parent.hasMode();
