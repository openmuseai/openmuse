{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schemas/bridge/v1/cancel.schema.json",
  "title": "Muse Bridge v1 cancellation payloads",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["cancellationId", "deadlineAt"],
      "properties": {
        "cancellationId": { "$ref": "https://muse.dev/schemas/bridge/v1/common.schema.json#/$defs/opaqueId" },
        "deadlineAt": { "$ref": "https://muse.dev/schemas/bridge/v1/common.schema.json#/$defs/timestampMs" }
      },
      "additionalProperties": false
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "required": ["ok", "value"],
          "properties": {
            "ok": { "const": true },
            "value": {
              "type": "object",
              "required": ["disposition"],
              "properties": {
                "disposition": { "enum": ["accepted", "already_terminal", "not_found"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        { "$ref": "https://muse.dev/schemas/bridge/v1/error.schema.json#/$defs/errorResult" }
      ]
    }
  }
}
