{
  "name": "@muse/plugin-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Hot-pluggable Muse capability discovery, binding, and DSH Tool lifecycle",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": { "node": ">=20.19.0" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./dsh": { "types": "./dist/src/dsh/index.d.ts", "import": "./dist/src/dsh/index.js" }
  },
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm typecheck && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@muse/host-bridge": "link:../protocol/host-bridge"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../vendors/deepseek-harness/vendor/cordis",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-system-prompt": "link:../../../../vendors/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../../../../vendors/deepseek-harness/packages/core/tools",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
