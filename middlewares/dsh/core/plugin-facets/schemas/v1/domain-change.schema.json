{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schemas/plugin-facets/v1/domain-change.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "pluginId", "providerInstanceRef", "scopeRef", "resourceRef", "eventType", "eventSchemaDigest", "domainRevision", "epochRef", "origin", "occurredAt", "payload"],
  "properties": {
    "protocol": { "const": "muse.domain-change/v1" },
    "pluginId": { "$ref": "#/$defs/id" }, "providerInstanceRef": { "$ref": "#/$defs/ref" },
    "scopeRef": { "$ref": "#/$defs/ref" }, "resourceRef": { "$ref": "#/$defs/ref" },
    "eventType": { "$ref": "#/$defs/nonBlank" }, "eventSchemaDigest": { "$ref": "#/$defs/digest" },
    "domainRevision": { "$ref": "#/$defs/revision" }, "epochRef": { "$ref": "#/$defs/ref" },
    "commandRef": { "$ref": "#/$defs/ref" },
    "origin": { "enum": ["ui-optimistic", "remote-collab", "external-command", "recovery-replay", "unknown"] },
    "occurredAt": { "$ref": "#/$defs/time" }, "payload": {}
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 160 },
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 160 },
    "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 32 },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
