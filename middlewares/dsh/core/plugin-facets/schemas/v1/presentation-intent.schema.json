{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.dev/schemas/plugin-facets/v1/presentation-intent.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "pluginId", "scopeRef", "intentType", "intentSchemaDigest", "intentRef", "requestedAt", "expiresAt", "payload"],
  "properties": {
    "protocol": { "const": "muse.presentation-intent/v1" }, "pluginId": { "$ref": "#/$defs/id" },
    "targetSurfaceInstanceRef": { "$ref": "#/$defs/ref" }, "scopeRef": { "$ref": "#/$defs/ref" },
    "intentType": { "$ref": "#/$defs/nonBlank" }, "intentSchemaDigest": { "$ref": "#/$defs/digest" },
    "intentRef": { "$ref": "#/$defs/ref" }, "requestedAt": { "$ref": "#/$defs/time" },
    "expiresAt": { "$ref": "#/$defs/time" }, "payload": {}
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 160 },
    "nonBlank": { "type": "string", "minLength": 1, "maxLength": 160 },
    "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  }
}
