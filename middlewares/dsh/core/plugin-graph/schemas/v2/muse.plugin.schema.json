{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse.local/schemas/v2/muse.plugin.schema.json",
  "title": "Muse Plugin Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "pluginId", "version", "artifacts", "facets"],
  "properties": {
    "protocol": { "const": "muse.plugin/v2" },
    "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "facets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/facet" } }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "kind", "entrypoint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "kind": { "enum": ["npm", "flutter-bundle", "rust-builtin", "remote"] },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "artifact", "runtimes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["agent", "presentation", "domain", "service"] },
        "artifact": { "type": "string", "minLength": 1 },
        "runtimes": { "type": "array", "minItems": 1, "items": { "enum": ["dsh-native", "flutter", "rust-host", "remote-dsh"] } },
        "platforms": { "type": "array", "items": { "enum": ["desktop", "mobile", "web"] } },
        "requires": { "type": "array", "items": { "type": "object" } },
        "provides": { "type": "array", "items": { "type": "object" } },
        "contributions": { "type": "array", "items": { "type": "object" } },
        "grants": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
