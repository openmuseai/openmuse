{
  "name": "@muse/context-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-neutral DSH context projection and prompt broker",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": { "node": ">=20.19.0" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./dsh": { "types": "./dist/src/dsh.d.ts", "import": "./dist/src/dsh.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@muse/host-bridge": "link:../protocol/host-bridge",
    "@muse/plugin-facets": "link:../plugin-facets"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../vendors/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-system-prompt": "link:../../../../vendors/deepseek-harness/packages/core/system-prompt",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
