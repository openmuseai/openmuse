{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["collapsed", "selectedText", "selectedBlockRefs"],
  "properties": {
    "collapsed": { "type": "boolean" },
    "selectedText": { "type": "string", "maxLength": 2048 },
    "selectedBlockRefs": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "uniqueItems": true }
  }
}
