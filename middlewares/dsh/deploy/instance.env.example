# Shared secrets for every tenant instance. systemd-run supplies PORT and
# DSH_HOME per process — do not set them here or they will clobber isolation.
MUSE_DOCUMENT_CLOUD_URL=https://openmuseai.com
MUSE_REQUIRE_HOST_AUTH=1
MUSE_MOBILE_BRIDGE=1
DEEPSEEK_API_KEY=
# Apex is the Web iframe Host (`/u/<hash>/`). dsh.<domain> is the dedicated vhost.
DSH_TRUSTED_HOST=openmuseai.com,dsh.openmuseai.com,127.0.0.1
