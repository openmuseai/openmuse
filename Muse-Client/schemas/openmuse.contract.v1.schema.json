{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmuse.local/schemas/openmuse.contract.v1.schema.json",
  "title": "OpenMuse cross-domain contract v1",
  "description": "Provider-neutral request, response and lifecycle snapshot wire vocabulary.",
  "oneOf": [
    { "$ref": "#/$defs/requestEnvelope" },
    { "$ref": "#/$defs/responseEnvelope" },
    { "$ref": "#/$defs/lifecycleSnapshot" }
  ],
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "major", "minor"],
      "properties": {
        "name": { "const": "openmuse.contract" },
        "major": { "type": "integer", "minimum": 1 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalRef", "kind"],
      "properties": {
        "principalRef": { "$ref": "#/$defs/opaqueRef" },
        "kind": { "enum": ["user", "agent", "plugin", "service", "device"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRef"],
      "properties": {
        "authorityRef": { "$ref": "#/$defs/opaqueRef" },
        "workspaceRef": { "$ref": "#/$defs/opaqueRef" },
        "resourceRef": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptRef", "requestId", "generation", "state", "issuedAtMs", "effects"],
      "properties": {
        "receiptRef": { "$ref": "#/$defs/opaqueRef" },
        "requestId": { "$ref": "#/$defs/opaqueRef" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "state": { "enum": ["committed", "rejected", "cancelled", "expired", "failed"] },
        "issuedAtMs": { "$ref": "#/$defs/safeInteger" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/opaqueRef" },
          "uniqueItems": true
        }
      }
    },
    "contractError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "enum": [
            "DENIED",
            "NOT_FOUND",
            "CONFLICT",
            "EXPIRED",
            "STALE_GENERATION",
            "UNAVAILABLE",
            "TRANSIENT",
            "INTEGRITY_FAILED"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "kind",
        "requestId",
        "actor",
        "caller",
        "scope",
        "generation",
        "deadlineAtMs",
        "cancellationRef",
        "operation",
        "payload"
      ],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "kind": { "const": "request" },
        "requestId": { "$ref": "#/$defs/opaqueRef" },
        "actor": { "$ref": "#/$defs/principal" },
        "caller": { "$ref": "#/$defs/principal" },
        "scope": { "$ref": "#/$defs/scope" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "deadlineAtMs": { "$ref": "#/$defs/safeInteger" },
        "cancellationRef": { "$ref": "#/$defs/opaqueRef" },
        "operation": { "$ref": "#/$defs/opaqueRef" },
        "payload": {}
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt", "value"],
          "properties": {
            "status": { "const": "ok" },
            "receipt": { "$ref": "#/$defs/receipt" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt", "error"],
          "properties": {
            "status": { "const": "error" },
            "receipt": { "$ref": "#/$defs/receipt" },
            "error": { "$ref": "#/$defs/contractError" }
          }
        }
      ]
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "kind",
        "requestId",
        "actor",
        "caller",
        "scope",
        "generation",
        "deadlineAtMs",
        "cancellationRef",
        "outcome"
      ],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "kind": { "const": "response" },
        "requestId": { "$ref": "#/$defs/opaqueRef" },
        "actor": { "$ref": "#/$defs/principal" },
        "caller": { "$ref": "#/$defs/principal" },
        "scope": { "$ref": "#/$defs/scope" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "deadlineAtMs": { "$ref": "#/$defs/safeInteger" },
        "cancellationRef": { "$ref": "#/$defs/opaqueRef" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorRef", "generation", "revision", "issuedAtMs", "value"],
      "properties": {
        "descriptorRef": { "$ref": "#/$defs/opaqueRef" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "revision": { "$ref": "#/$defs/opaqueRef" },
        "issuedAtMs": { "$ref": "#/$defs/safeInteger" },
        "value": {}
      }
    },
    "handle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handleRef", "audience", "scope", "access", "generation", "issuedAtMs", "expiresAtMs", "state"],
      "properties": {
        "handleRef": { "$ref": "#/$defs/opaqueRef" },
        "audience": { "$ref": "#/$defs/principal" },
        "scope": { "$ref": "#/$defs/scope" },
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueRef" }
        },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "issuedAtMs": { "$ref": "#/$defs/safeInteger" },
        "expiresAtMs": { "$ref": "#/$defs/safeInteger" },
        "state": { "enum": ["active", "revoked", "expired"] }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaseRef", "holder", "scope", "generation", "issuedAtMs", "expiresAtMs", "state"],
      "properties": {
        "leaseRef": { "$ref": "#/$defs/opaqueRef" },
        "holder": { "$ref": "#/$defs/principal" },
        "scope": { "$ref": "#/$defs/scope" },
        "generation": { "$ref": "#/$defs/safeInteger" },
        "issuedAtMs": { "$ref": "#/$defs/safeInteger" },
        "expiresAtMs": { "$ref": "#/$defs/safeInteger" },
        "state": { "enum": ["active", "released", "revoked", "expired"] }
      }
    },
    "lifecycleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "descriptor", "handle", "lease", "receipt"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "descriptor": { "$ref": "#/$defs/descriptor" },
        "handle": { "$ref": "#/$defs/handle" },
        "lease": { "$ref": "#/$defs/lease" },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    }
  }
}
