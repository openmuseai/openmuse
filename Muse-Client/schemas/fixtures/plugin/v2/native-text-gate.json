      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "native-text.host.macos-x86_64",
      "kind": "host-bundle",
      "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "native-text.host.windows-x86_64",
      "kind": "host-bundle",
      "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" },
      "digest": { "algorithm": "sha256", "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
