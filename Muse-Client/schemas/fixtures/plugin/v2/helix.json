{
  "manifest_version": 2,
  "id": "com.openmuse.helix",
  "name": "Helix Editor",
  "version": "0.1.0",
  "protocol": { "major": 1, "minor": 0 },
  "ui_runtime": { "kind": "flutter" },
  "execution_connector": { "kind": "host-process", "protocol": "openmuse.helix-control/v1" },
  "compatibility": {
    "targets": [
      { "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" }, "status": "supported" },
      { "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" }, "status": "supported" },
      { "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" }, "status": "supported" },
      { "target": { "os": "linux", "arch": "x86_64", "libc": "gnu" }, "status": "unsupported", "reason": "Linux distribution pipeline is not implemented" },
      { "target": { "os": "android", "arch": "aarch64", "libc": "bionic" }, "status": "unsupported", "reason": "Helix requires a desktop PTY and native process runtime" },
      { "target": { "os": "ios", "arch": "aarch64", "libc": "darwin" }, "status": "unsupported", "reason": "Helix requires a desktop PTY and native process runtime" }
    ]
  },
  "artifacts": [
    {
      "id": "helix.host.macos-aarch64",
      "kind": "host-bundle",
      "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "1111111111111111111111111111111111111111111111111111111111111111" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "helix.engine.macos-aarch64",
      "kind": "native-executable",
      "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "2222222222222222222222222222222222222222222222222222222222222222" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "MPL-2.0",
      "abi": "openmuse.helix-control/v1"
    },
    {
      "id": "helix.host.macos-x86_64",
      "kind": "host-bundle",
      "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "3333333333333333333333333333333333333333333333333333333333333333" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "helix.engine.macos-x86_64",
      "kind": "native-executable",
      "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "4444444444444444444444444444444444444444444444444444444444444444" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "MPL-2.0",
      "abi": "openmuse.helix-control/v1"
    },
    {
      "id": "helix.host.windows-x86_64",
      "kind": "host-bundle",
      "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" },
      "digest": { "algorithm": "sha256", "value": "5555555555555555555555555555555555555555555555555555555555555555" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "helix.engine.windows-x86_64",
      "kind": "native-executable",
      "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" },
      "digest": { "algorithm": "sha256", "value": "6666666666666666666666666666666666666666666666666666666666666666" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "MPL-2.0",
      "abi": "openmuse.helix-control/v1"
    }
  ],
  "activation_events": ["onFileType:text", "onCommand:helix.open"],
  "requested_permissions": ["filesystem.workspace.read", "filesystem.workspace.write", "process.pty", "clipboard.read", "clipboard.write"],
  "presentation": { "surfaces": ["editor"], "remote_capable": false },
  "contributes": {
    "commands": [
      { "id": "helix.open", "title": "Open in Helix", "required_permissions": ["filesystem.workspace.read"] }
    ],
    "services": [],
    "editors": [
      { "id": "helix.editor", "extensions": ["txt", "md", "rs", "dart", "ts", "js", "json", "yaml", "toml"], "priority": 50 }
    ],
    "panels": [],
    "agent_cli": []
  }
}
