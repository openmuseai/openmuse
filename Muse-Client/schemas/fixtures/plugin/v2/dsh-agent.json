{
  "manifest_version": 2,
  "id": "com.openmuse.dsh-agent",
  "name": "DSH Agent",
  "version": "0.1.0",
  "protocol": { "major": 1, "minor": 0 },
  "ui_runtime": { "kind": "flutter" },
  "execution_connector": { "kind": "host-process", "protocol": "openmuse.dsh-bridge/v1" },
  "compatibility": {
    "targets": [
      { "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" }, "status": "supported" },
      { "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" }, "status": "supported" },
      { "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" }, "status": "supported" },
      { "target": { "os": "linux", "arch": "x86_64", "libc": "gnu" }, "status": "unsupported", "reason": "Linux DSH closure is not qualified" },
      { "target": { "os": "android", "arch": "aarch64", "libc": "bionic" }, "status": "unsupported", "reason": "Remote DSH connector is delivered by M2, not the desktop sidecar" },
      { "target": { "os": "ios", "arch": "aarch64", "libc": "darwin" }, "status": "unsupported", "reason": "Remote DSH connector is delivered by M2, not the desktop sidecar" }
    ]
  },
  "artifacts": [
    {
      "id": "dsh.host.macos-aarch64",
      "kind": "host-bundle",
      "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "7777777777777777777777777777777777777777777777777777777777777777" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "dsh.runtime.macos-aarch64",
      "kind": "runtime-closure",
      "target": { "os": "macos", "arch": "aarch64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "8888888888888888888888888888888888888888888888888888888888888888" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "Apache-2.0",
      "abi": "openmuse.dsh-bridge/v1"
    },
    {
      "id": "dsh.host.macos-x86_64",
      "kind": "host-bundle",
      "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "9999999999999999999999999999999999999999999999999999999999999999" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "dsh.runtime.macos-x86_64",
      "kind": "runtime-closure",
      "target": { "os": "macos", "arch": "x86_64", "libc": "darwin" },
      "digest": { "algorithm": "sha256", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "Apache-2.0",
      "abi": "openmuse.dsh-bridge/v1"
    },
    {
      "id": "dsh.host.windows-x86_64",
      "kind": "host-bundle",
      "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" },
      "digest": { "algorithm": "sha256", "value": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" },
      "license": "AGPL-3.0-only",
      "abi": "openmuse.plugin-ui/v2"
    },
    {
      "id": "dsh.runtime.windows-x86_64",
      "kind": "runtime-closure",
      "target": { "os": "windows", "arch": "x86_64", "libc": "msvc" },
      "digest": { "algorithm": "sha256", "value": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" },
      "signature": { "algorithm": "ed25519", "key_id": "fixture.release", "value": "fixture-signature" },
      "license": "Apache-2.0",
      "abi": "openmuse.dsh-bridge/v1"
    }
  ],
  "activation_events": ["onStartup", "onPanel:dsh.agent"],
  "requested_permissions": ["workspace.context.read", "resource.open.request", "process.sidecar", "credentials.model.use"],
  "presentation": { "surfaces": ["right-sidebar"], "remote_capable": false },
  "contributes": {
    "commands": [],
    "services": [],
    "editors": [],
    "panels": [
      { "id": "dsh.agent", "region": "right-sidebar", "priority": 100 }
    ],
    "agent_cli": [
      {
        "group": "agent",
        "namespace": "dsh",
        "command": "prompt",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt"],
          "properties": { "prompt": { "type": "string", "minLength": 1 } }
        },
        "required_permissions": ["credentials.model.use", "workspace.context.read"],
        "effects": ["conversation.write", "workspace.read"]
      }
    ]
  }
}
