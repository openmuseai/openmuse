# =============================================================================
# OpenMuse local desktop — repository ignore rules
#
# Tracked on purpose: product source, workspace manifests and lockfiles, JSON
# contracts and schemas, plugin manifests and their small assets, README.
#
# Ignored on purpose: build outputs, package-manager caches, native toolchain
# scaffolding, generated runtime closures and release archives. Build scripts,
# architecture/provenance docs and pinned third-party inputs are source assets.
# =============================================================================

# --- Build outputs -----------------------------------------------------------
/target/
/dist/
**/build/
**/coverage/

# Per-domain fingerprints and reuse markers written by scripts/ci/build-windows.ps1.
# They describe a local build, and in CI they travel inside the domain cache entry.
/.muse-domain-cache/

# --- Dart / Flutter ----------------------------------------------------------
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/Flutter/ephemeral/
**/Flutter/.last_build_id
**/.symlinks/
app.*.symbols
app.*.map.json

# --- Native / macOS / CocoaPods ---------------------------------------------
**/Pods/
**/xcuserdata/
**/*.xcuserstate
**/*.dgph
**/DerivedData/
*.ipa
*.dSYM/
*.hmap
*.xcarchive/

# --- Windows / Visual Studio -------------------------------------------------
**/x64/
**/x86/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Node / sidecar runtime --------------------------------------------------
**/node_modules/

# --- Vendored engine and third-party binaries --------------------------------
# The Helix engine binary and the staged runtime are large generated inputs: the
# packaging helpers require them in the working tree, but they are not committed.
# The manifests, lockfiles, checksums, licence texts and publish orders that
# describe them are tracked, as are the OpenMuse-authored overrides below.
/plugins/helix/assets/engines/helix/hx
/plugins/helix/assets/engines/helix/runtime/*
# OpenMuse-authored theme: source, not a staged engine artefact.
!/plugins/helix/assets/engines/helix/runtime/themes
/plugins/helix/assets/engines/helix/runtime/themes/*
!/plugins/helix/assets/engines/helix/runtime/themes/openmuse_dark.toml
/third_party/dsh/tarballs/**/*.tgz

# --- Release bundles ---------------------------------------------------------
*.zip
*.dmg
*.pkg
*.tar.gz

# --- Development-process material -------------------------------------------
# Keep architecture and release scripts in the independent source repository.
/tmp/
/scratch/
/notes/
*.local.md
*.draft.md
*.tmp
*.bak
*.orig
*.rej

# --- Tooling / editors -------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.history/
.atom/
.buildlog/
migrate_working_dir/
*.swp
*.class
*.pyc

# --- OS noise ----------------------------------------------------------------
.DS_Store
._*
*.log
